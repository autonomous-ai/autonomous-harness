{
  "spec": 1,
  "id": "autonomous/yosys",
  "name": "Yosys",
  "category": "Chips",
  "author": "YosysHQ",
  "description": "Describe a digital circuit — a counter, a UART, a state machine — and get Verilog, a simulation with waveforms, a synthesized gate-level schematic and an FPGA bitstream for an iCE40 board. Prompt to silicon.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "rtl/blink.v",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills"],
    "env": {
      "YOSYS_TOOLCHAIN": "${dsh}/toolchain",
      "YOSYS_FLOW": "${dsh}/toolchain/flow.sh"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "./viewer.sh",
    "url": "http://127.0.0.1:${port}/?file=${artifact}",
    "artifactExtensions": [".svg", ".json"]
  },
  "verdict": ".harness/verdict.json"
}
