{
  "spec": 1,
  "id": "autonomous/ableton-ai",
  "name": "Ableton AI",
  "category": "Music",
  "author": "Freek Van der Herten and contributors",
  "description": "A small pattern can become a whole mood. Make a loop, play with its pulse, and keep the happy accidents.",
  "engine": "codex",
  "workspace": {
    "template": "template",
    "marker": "studio.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "STUDIO_TOOLCHAIN": "${dsh}/toolchain",
      "STUDIO_PYTHON": "${dsh}/.venv/bin/python",
      "STUDIO_UPSTREAM": "${dsh}/upstream"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/studio-viewer"
  },
  "verdict": ".harness/verdict.json"
}
