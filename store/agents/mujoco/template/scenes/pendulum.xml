<mujoco model="pendulum">
  <!-- Your own MJCF goes here. Load it with load_xml("scenes/pendulum.xml"). -->
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom type="plane" size="2 2 .1" rgba=".9 .9 .9 1"/>
    <body name="pole" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.6" size="0.03" rgba=".2 .5 .9 1" mass="0.5"/>
    </body>
  </worldbody>
  <actuator>
    <motor joint="hinge" gear="1" ctrlrange="-2 2"/>
  </actuator>
  <keyframe>
    <key name="tilted" qpos="0.8"/>
  </keyframe>
</mujoco>
