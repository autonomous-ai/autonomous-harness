{
  "spec": 1,
  "id": "autonomous/voxel-worlds",
  "name": "Voxel Worlds",
  "category": "Games",
  "author": "Autonomous",
  "description": "Build and walk a seeded voxel island. Sculpt terrain, place and break blocks, explore a cabin and lighthouse, change the light, and save your world.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "world/index.html",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "VOXEL_DSH_DIR": "${dsh}"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/web-viewer",
    "artifactExtensions": [
      ".html"
    ],
    "url": "http://127.0.0.1:${port}/?file=${artifact}"
  },
  "verdict": ".harness/verdict.json"
}
