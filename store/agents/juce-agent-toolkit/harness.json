{
  "spec": 1,
  "id": "autonomous/juce-agent-toolkit",
  "name": "JUCE Agent Toolkit",
  "category": "Audio",
  "author": "Daniel Raffel",
  "description": "Find a sound that feels like you. Shape a synth, play a little, and take the recording with you.",
  "engine": "codex",
  "workspace": {
    "template": "template",
    "marker": "studio.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ],
    "env": {
      "STUDIO_TOOLCHAIN": "${dsh}/toolchain",
      "STUDIO_PYTHON": "${dsh}/.venv/bin/python",
      "STUDIO_UPSTREAM": "${dsh}/upstream"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/studio-viewer"
  },
  "verdict": ".harness/verdict.json"
}
