{
  "spec": 1,
  "id": "autonomous/jev-arena",
  "name": "Jev Arena",
  "category": "AI",
  "author": "Autonomous",
  "description": "A live grid world powered by Jev, TypeSafe's System One model. Jev decides every move in real time — watch its probability distributions and confidence as it thinks, and redesign the world to test it.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "arena.json",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": ["skills"],
    "env": {
      "JEV_DSH": "${dsh}",
      "JEV_MODEL": "jev-latest"
    }
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "command": "toolchain/viewer.sh",
    "url": "http://127.0.0.1:${port}/",
    "artifactExtensions": [".json"]
  },
  "verdict": ".harness/verdict.json"
}
