{
  "spec": 1,
  "id": "autonomous/drone-pilot",
  "name": "Drone / FPV Pilot",
  "category": "Simulation",
  "author": "Autonomous",
  "description": "Describe a flight — a course, a line, a stunt, an obstacle run — and get a deterministic, seedable first-person drone sim in the pane with throttle/steer controls and a re-seed.",
  "engine": "claude",
  "workspace": {
    "template": "template",
    "marker": "flight/index.html",
    "init": "toolchain/init-workspace.sh"
  },
  "agent": {
    "instructions": "AGENTS.md",
    "skills": [
      "skills"
    ]
  },
  "toolchain": {
    "setup": "toolchain/setup.sh",
    "doctor": "toolchain/doctor.sh"
  },
  "viewer": {
    "use": "autonomous/web-viewer",
    "artifactExtensions": [
      ".html"
    ]
  },
  "verdict": ".harness/verdict.json"
}
