# ESP-IDF build output & downloaded components (regenerated by idf.py)
build/
managed_components/
.cache/
dependencies.lock

# Generated config. sdkconfig.defaults is the tracked source of truth; CMakeLists.txt regenerates
# sdkconfig whenever the defaults hash changes (see the comment there), leaving the old one as
# sdkconfig.superseded.
sdkconfig
sdkconfig.old
sdkconfig.superseded
sdkconfig.defaults.stamp
build-arm

# Local pairing secrets (WiFi password / API key) — do not commit.
# Copy main/provisioned_config.h.example → main/provisioned_config.h and fill in.
# The .local variant is a per-machine override that also carries secrets.
main/provisioned_config.h
main/provisioned_config.h.local
build-prod/

# Design mockups: HTML frames used to agree on a layout BEFORE writing LVGL code. They are a
# conversation, not a build input — nothing here compiles or ships.
mockup/
build-probe/
