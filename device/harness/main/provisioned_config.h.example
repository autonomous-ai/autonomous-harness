// Compile-time NETWORK config — skips the SoftAP portal (WiFi + backend URL only).
// The device token comes from the on-screen 6-digit pairing flow (stored in NVS), so it
// is NOT baked in here. Copy to provisioned_config.h and fill in; set DEVICE_FORCE_CONFIG
// to 0 to use the captive portal instead. provisioned_config.h is gitignored.
//
// PRODUCTION: keep DEVICE_FORCE_CONFIG=0 so WiFi comes from NVS/the portal. When the saved
// WiFi can't be joined (user roamed office<->home), the device auto-reboots into the SoftAP
// "Harness-Setup" portal to enter the new network from a phone — the backend host is
// pre-filled & locked and the pairing token is preserved (no re-pair). DEVICE_FORCE_CONFIG=1
// bakes the creds below for development and effectively disables that auto-portal fallback.
#pragma once

#define DEVICE_FORCE_CONFIG 0

#define DEVICE_WIFI_SSID   "YOUR_WIFI_SSID"
#define DEVICE_WIFI_PASS   "YOUR_WIFI_PASS"
#define DEVICE_BACKEND_URL "ws://HOST:8085"   // central backend; REST base derived from this
