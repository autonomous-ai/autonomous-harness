#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/terminal_web/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Design scratch — icon/layout comparisons rendered for a human to look at.
# They inline whole font files to stay openable straight off disk, so they are
# megabytes of base64 that git would keep forever for a page nobody reads twice.
/mockup/

# ---------------------------------------------------------------------------
# Local / personal — machine- or developer-specific, never pushed
# ---------------------------------------------------------------------------

# AI coding assistants (chat history, local rules, per-dev config).
# .claude/ contents are ignored by default; whitelist below anything the team
# should actually share (drop the leading "#" to start tracking it).
.claude/*
#!.claude/settings.json
#!.claude/commands/
#!.claude/agents/
#!.claude/skills/
.claude/settings.local.json
CLAUDE.local.md
AGENTS.local.md

