# Copy to .env and fill in. `.env` is gitignored — it holds a real credential.
#
# These are the `claude` CLI's own environment variables, so any Anthropic-compatible endpoint works:
# a gateway in front of another model, a proxy, or the Anthropic API itself.
#
# ALL THREE OR NONE. Set none of them and the CLI uses whatever `claude` is logged into locally.
# Set some but not all and the provider refuses to start — a base URL without a model would otherwise
# send `claude-sonnet-5` to a gateway that has never heard of it, and you would find out mid-turn,
# with a user watching, instead of at boot.

ANTHROPIC_BASE_URL=https://my-gateway.example.com
ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_API_KEY works too — use whichever name your endpoint hands out.

# Must be a model the endpoint above actually serves. It is also what goes to `--model`, so there is
# only ever one model name in play.
ANTHROPIC_MODEL=my-custom-model

# Optional. The CLI's small-model slot, used for the per-turn recap one-shot — a headline is not the
# work, so it does not need the big model. Falls back to CLAUDE_RECAP_MODEL, then the built-in default.
# ANTHROPIC_SMALL_FAST_MODEL=my-small-model

# Everything below is unrelated to credentials and already had a default; override only if you need to.
# PORT=4502
# AGENTS_FILE=./agents.json
# WORKSPACE_ROOT=/tmp/example-provider-scratch
# RECAP_DISABLED=1
