{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.autonomous.ai/api/a2a/ext/session-recap",
  "title": "Extension: session-recap",
  "description": "Short persisted per-turn summaries for an agent. The Harness device restores its tiles from these after a reboot; without the extension the device shows nothing rather than stale text (HP-302). Each $defs entry carries its own examples.",
  "type": "object",
  "$defs": {
    "recapRequest": {
      "type": "object",
      "required": ["agentId"],
      "properties": {
        "agentId": { "type": "string" },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 2,
          "description": "How many recent turns to return, most recent first."
        }
      },
      "examples": [
        { "agentId": "acme-reporting", "n": 2 },
        { "agentId": "acme-reporting" }
      ]
    },
    "recapEntry": {
      "type": "object",
      "required": ["recap"],
      "properties": {
        "recap": {
          "type": "string",
          "maxLength": 200,
          "description": "Headline-style summary of what the turn accomplished. Kept short because it renders on a small round display readable across a room."
        },
        "body": { "type": "string", "maxLength": 2000 },
        "contextId": { "type": "string" },
        "taskId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "examples": [
        { "recap": "Flagged Acme overspend at 118% of pacing", "contextId": "ctx-91af", "timestamp": "2026-08-03T09:14:00Z" },
        { "recap": "Built weekly budget alert query" }
      ]
    },
    "recapResponse": {
      "type": "object",
      "required": ["agentId", "entries"],
      "properties": {
        "agentId": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/recapEntry" },
          "description": "Empty until at least one turn has been summarised. An empty array is correct; fabricated or full-text entries are not."
        }
      },
      "examples": [
        {
          "agentId": "acme-reporting",
          "entries": [
            { "recap": "Flagged Acme overspend at 118% of pacing", "contextId": "ctx-91af", "timestamp": "2026-08-03T09:14:00Z" },
            { "recap": "Built weekly budget alert query", "contextId": "ctx-77bc" }
          ]
        },
        { "agentId": "acme-reporting", "entries": [] }
      ]
    }
  }
}
