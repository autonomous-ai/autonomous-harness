{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.autonomous.ai/api/a2a/ext/workspace-write",
  "title": "Extension: workspace-write",
  "description": "Create, rename and delete projects and sessions. Declared in AgentCard.extensions with params.projects / params.sessions indicating which halves are supported (HP-301). A provider MUST enforce that every operation stays inside the tenant identified by the credential. Each $defs entry carries its own examples.",
  "type": "object",
  "$defs": {
    "projectCreateRequest": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "examples": [
        { "name": "Acme weekly reporting", "description": "Budget pacing alerts" },
        { "name": "Globex Q3" }
      ]
    },
    "projectRenameRequest": {
      "type": "object",
      "required": ["projectId", "name"],
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "examples": [{ "projectId": "acme-reporting", "name": "Acme reporting (2026)" }]
    },
    "projectDeleteRequest": {
      "type": "object",
      "required": ["projectId"],
      "properties": { "projectId": { "type": "string" } },
      "examples": [{ "projectId": "acme-reporting" }]
    },
    "projectResponse": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "description": "The remaining client-side project fields (userId, status, timestamps) are synthesised by the Autonomous backend — see §10.3 of the spec. A provider MUST NOT invent them, and MUST NOT report an `engine`.",
      "examples": [
        { "id": "acme-reporting", "name": "Acme weekly reporting" },
        { "id": "globex-q3", "name": "Globex Q3", "description": "Quarterly rollup" }
      ]
    },
    "sessionUpdateTitleRequest": {
      "type": "object",
      "required": ["contextId", "title"],
      "properties": {
        "contextId": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "examples": [{ "contextId": "ctx-91af", "title": "Budget overrun investigation" }]
    },
    "sessionDeleteRequest": {
      "type": "object",
      "required": ["contextId"],
      "properties": { "contextId": { "type": "string" } },
      "examples": [{ "contextId": "ctx-91af" }]
    },
    "ackResponse": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "examples": [{ "ok": true }, { "ok": false, "message": "Project not found" }]
    }
  }
}
