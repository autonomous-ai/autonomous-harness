{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.autonomous.ai/api/a2a/schema/part-metadata.json",
  "title": "autonomous.ai/* metadata on an A2A Part",
  "description": "Optional enrichment carried on the `metadata` object of a standard A2A Part. A provider that emits none of this is conformant — its output renders as plain assistant text (HP-211). Unknown autonomous.ai/* keys MUST be ignored, not rejected (HP-210).",
  "type": "object",
  "properties": {
    "autonomous.ai/kind": {
      "enum": [
        "user_message",
        "thinking_delta",
        "thinking_title",
        "text_delta",
        "tool_start",
        "tool_end",
        "context_compact",
        "done"
      ]
    },
    "autonomous.ai/thinkingId": {
      "type": "string",
      "description": "Groups thinking_delta chunks and their thinking_title."
    },
    "autonomous.ai/toolCallId": {
      "type": "string",
      "description": "Correlates a tool_start with its tool_end."
    },
    "autonomous.ai/parentToolCallId": {
      "type": "string",
      "description": "Set when this part belongs to a nested/sub-agent call, so the client can render a tree."
    },
    "autonomous.ai/tool": {
      "type": "string",
      "description": "Tool name, for tool_start and tool_end."
    },
    "autonomous.ai/toolInput": {
      "description": "Arbitrary JSON arguments for tool_start."
    },
    "autonomous.ai/isError": {
      "type": "boolean",
      "description": "tool_end only: the tool call failed."
    },
    "autonomous.ai/summary": {
      "type": "string",
      "description": "tool_end only: one-line human summary of the result."
    },
    "autonomous.ai/durationSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "tool_end only."
    },
    "autonomous.ai/title": {
      "type": "string",
      "description": "thinking_title only."
    },
    "autonomous.ai/compacted": {
      "type": "object",
      "description": "context_compact only. All counts optional — omit rather than guess (HP-220). The human-readable explanation travels as the Part's own text.",
      "properties": {
        "userMessages": { "type": "integer", "minimum": 0 },
        "assistantMessages": { "type": "integer", "minimum": 0 },
        "toolUses": { "type": "integer", "minimum": 0 },
        "contexts": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "autonomous.ai/kind": { "const": "tool_start" } },
        "required": ["autonomous.ai/kind"]
      },
      "then": { "required": ["autonomous.ai/toolCallId", "autonomous.ai/tool"] }
    },
    {
      "if": {
        "properties": { "autonomous.ai/kind": { "const": "tool_end" } },
        "required": ["autonomous.ai/kind"]
      },
      "then": { "required": ["autonomous.ai/toolCallId", "autonomous.ai/tool"] }
    },
    {
      "if": {
        "properties": { "autonomous.ai/kind": { "const": "thinking_title" } },
        "required": ["autonomous.ai/kind"]
      },
      "then": { "required": ["autonomous.ai/title"] }
    }
  ],
  "examples": [
    { "autonomous.ai/kind": "text_delta" },
    { "autonomous.ai/kind": "thinking_delta", "autonomous.ai/thinkingId": "t1" },
    { "autonomous.ai/kind": "thinking_title", "autonomous.ai/thinkingId": "t1", "autonomous.ai/title": "Checking the budget data" },
    {
      "autonomous.ai/kind": "tool_start",
      "autonomous.ai/toolCallId": "c7",
      "autonomous.ai/tool": "query_spend",
      "autonomous.ai/toolInput": { "account": "acme", "window": "7d" }
    },
    {
      "autonomous.ai/kind": "tool_end",
      "autonomous.ai/toolCallId": "c7",
      "autonomous.ai/tool": "query_spend",
      "autonomous.ai/isError": false,
      "autonomous.ai/summary": "Returned 7 rows",
      "autonomous.ai/durationSeconds": 1.4
    },
    { "autonomous.ai/kind": "done" },
    {
      "autonomous.ai/kind": "context_compact",
      "autonomous.ai/compacted": { "userMessages": 12, "assistantMessages": 12, "toolUses": 41 }
    },
    { "autonomous.ai/kind": "context_compact" },
    { "autonomous.ai/kind": "user_message" },
    {}
  ]
}
