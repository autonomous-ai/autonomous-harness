<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenHarness</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>harness</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- ⚠️ DECISION, NOT A DEFAULT — and it is currently the OPTIMISTIC one.
	     `false` auto-answers App Store Connect's export-compliance question and
	     is right only for an app whose encryption is the OS's own (an HTTPS
	     call). This app is not that: it terminates its own end-to-end
	     encryption — X25519, ChaCha20-Poly1305 and a CPace PAKE, in `lib/e2ee/`
	     — so the honest answer is very likely `true` plus a self-classification
	     report, or an exemption confirmed with whoever owns export compliance.
	     Getting it wrong is not a build error: review asks, and the version
	     sits still until someone answers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Taking a picture to send to an agent. Only the camera needs a string on
	     iOS 15: picking from the library goes through PHPicker, which runs out of
	     process and grants nothing, so NSPhotoLibraryUsageDescription would never
	     be shown and is deliberately absent. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to send to an agent in a terminal.</string>
	<!-- Voice input, what tapping a terminal opens. Asked for on the first tap,
	     not at launch. The microphone alone: the recording is transcribed by
	     the Harness backend (`/api/voice/stt`, the dial's own path), not by the
	     OS, so there is no Speech Recognition permission to ask for. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to an agent in a terminal instead of typing.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
